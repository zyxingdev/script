#!name =  iRingo: 🌤 WeatherKit QX Fix
#!desc = 修复 iOS 26.6 WeatherKit country 丢失导致空气质量无法注入的问题，并保持原仓库默认欧标空气质量等级。
#!author = NSRingo + local fix
#!homepage = https://github.com/NSRingo/WeatherKit/issues/65
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category =  iRingo
#!date = 2026-06-03 18:20:00
#!version = 4.0.0-beta3-qx-cn-aqhi-labels

#[filter_local]
host, weather-analytics-events.apple.com, reject
host-suffix, tthr.apple.com, reject
host, tether.edge.apple, reject

#[rewrite_local]
# 🌤 WeatherKit.api.v2.weather.request
^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ url script-request-header https://raw.githubusercontent.com/zyxingdev/script/main/WeatherKit/WeatherKit.Country.qx.js
# 🌤 WeatherKit.api.v1.availability.response
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/ url script-response-body https://raw.githubusercontent.com/zyxingdev/script/main/WeatherKit/response.bundle.js
# 🌤 WeatherKit.api.v1.airQualityScale.request
^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/ url script-request-header https://raw.githubusercontent.com/zyxingdev/script/main/WeatherKit/request.bundle.js
# 🌤 WeatherKit.api.v2.weather.response
^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/ url script-response-body https://raw.githubusercontent.com/zyxingdev/script/main/WeatherKit/response.bundle.js

#[mitm]
hostname = weatherkit.apple.com
