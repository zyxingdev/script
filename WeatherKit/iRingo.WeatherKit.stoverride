#SUBSCRIBED https://raw.githubusercontent.com/zyxingdev/script/main/WeatherKit/iRingo.WeatherKit.stoverride
name: " iRingo: 🌤 WeatherKit"
desc: |-
  iOS 18 & macOS 15 & watchOS 11
  1.解锁全部天气功能
  2.替换空气质量数据
  3.添加下一小时降水数据
  4.添加天气数据
openUrl: "http://boxjs.com/#/app/iRingo.WeatherKit"
author: |-
  VirgilClyne[https://github.com/VirgilClyne]
  WordlessEcho[https://github.com/WordlessEcho]
  001[https://github.com/001ProMax]
homepage: "https://NSRingo.github.io/guide/Weather/weather-kit"
icon: "https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png"
category: " iRingo"
date: "2026-06-18 00:00:00"
version: "4.0.0-beta3-stash-fix5"

rules:
  - DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
  - DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP
  - DOMAIN,tether.edge.apple,REJECT-DROP
  - AND,((OR,((IP-ASN,714,no-resolve),(IP-ASN,6185,no-resolve))),(PROTOCOL,QUIC)),REJECT-DROP

http:
  mitm:
    - "weatherkit.apple.com"
  script:
    # Normalize dataSets and restore the country parameter omitted by some macOS requests.
    - match: ^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/
      name: WeatherKit.api.v2.weather.request
      type: request
      argument:
    - match: ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/
      name: WeatherKit.api.v1.availability.response
      type: response
      require-body: true
      argument:
    # iPhone and macOS fetch this scale for AQI glyphs and localized descriptions.
    - match: ^https?:\/\/weatherkit\.apple\.com\/api\/v1\/airQualityScale\/
      name: WeatherKit.api.v1.airQualityScale.request
      type: request
      argument:
    - match: ^https?:\/\/weatherkit\.apple\.com\/api\/v2\/weather\/
      name: WeatherKit.api.v2.weather.response
      type: response
      require-body: true
      binary-mode: true
      argument: "Storage=Argument&AirQuality.Calculate.Algorithm=WAQI_InstantCast_CN&AirQuality.Comparison.Yesterday.IndexProvider=Calculate"

script-providers:
  WeatherKit.api.v2.weather.request:
    url: https://raw.githubusercontent.com/zyxingdev/script/main/WeatherKit/request.bundle.js
    interval: 86400
  WeatherKit.api.v1.availability.response:
    url: https://raw.githubusercontent.com/zyxingdev/script/main/WeatherKit/response.bundle.js
    interval: 86400
  WeatherKit.api.v1.airQualityScale.request:
    url: https://raw.githubusercontent.com/zyxingdev/script/main/WeatherKit/WeatherKit.AirQualityScale.qx.js?version=fix5
    interval: 86400
  WeatherKit.api.v2.weather.response:
    url: https://raw.githubusercontent.com/zyxingdev/script/main/WeatherKit/response.bundle.js
    interval: 86400
