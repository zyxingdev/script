#!name = 京东 iOS 开屏去广告（Quantumult X）
#!desc = 清理京东启动接口下发的开屏广告，并拦截启动广告图片。
#!author = zyxingdev
#!homepage = https://github.com/zyxingdev/script
#!date = 2026-07-19 00:00:00
#!version = 2.0.0

#[rewrite_local]
# 京东主开屏接口：保留响应结构并使广告失效
^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]+&)*functionId=start(?:&|$) url script-response-body https://raw.githubusercontent.com/zyxingdev/script/main/JD/JD_remove_ads.qx.js

# 京东新版启动配置接口：返回空字典
^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^&]+&)*functionId=home_launchConfig(?:&|$) url reject-dict

# 京东启动广告素材兜底
^https?:\/\/img\d+\.360buyimg\.com\/jddjadvertise\/ url reject

#[mitm]
hostname = %APPEND% api.m.jd.com, img*.360buyimg.com
