#!name = 京东去广告（Quantumult X）
#!desc = 屏蔽京东启动页广告、DNS 配置和直播入口；清空服务端下发的 dnsvip。
#!author = zyxingdev
#!homepage = https://github.com/zyxingdev/script
#!date = 2026-07-17 00:00:00
#!version = 1.0.0

#[rewrite_local]
# 京东启动页广告
^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs url reject-200

# 禁用京东自有 DNS 解析
^https?:\/\/dns\.jd\.com\/ url reject
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:server|basic)Config(?:&|$) url script-response-body https://raw.githubusercontent.com/zyxingdev/script/main/JD/JD_remove_ads.qx.js

# 禁用京东直播小窗
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=getWidgetV1052(?:&|$) url reject

# 禁用京东店铺页直播；会同时移除活动弹窗、关注按钮和直播观看入口
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:live|getShopHomeExtendInfo|getImmediatePlayV910)(?:&|$) url reject

#[mitm]
hostname = %APPEND% m.360buyimg.com, dns.jd.com, api.m.jd.com
