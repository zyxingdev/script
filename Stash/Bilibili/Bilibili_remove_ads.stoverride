#SUBSCRIBED https://raw.githubusercontent.com/zyxingdev/script/main/Stash/Bilibili/Bilibili_remove_ads.stoverride
name: |-
  哔哩哔哩去广告
desc: |-
  过滤哔哩哔哩广告、移除青少年模式弹窗和交互式弹幕、移除无用功能和链接跟踪参数，增加空降助手以便跳过视频中插入的广告。此插件仅建议iOS 15以上设备使用，且必须启用MitM-over-HTTP/2功能。\n\n空降助手是第三方提供的功能，依赖于Android版空降助手的服务器数据运作，可能会存在不准确或者失效的问题，此功能与哔哩哔哩官方无关。
author: |-
  kokoryh[https://github.com/kokoryh]
icon: |-
  https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/Bilibili.png
openUrl: |-
  https://apps.apple.com/app/id736536022
category: "去广告"
system: |-
  iOS, iPadOS
system_version: |-
  15
loon_version: |-
  3.4.0(962)
homepage: |-
  https://hub.kelee.one
date: |-
  2026-07-23 03:45:56

rules:
  # 取消整域拒绝，避免 B 站客户端失败后重试或切换线路。
  - AND,((DOMAIN-SUFFIX,chat.bilibili.com),(OR,((DOMAIN-KEYWORD,stun),(DOMAIN-KEYWORD,tracker),(DOMAIN-KEYWORD,p2p)))),REJECT

http:

  mitm:
    # grpc.biliapi.net 保持直连，避免 History gRPC 被整域 MITM 拖慢。
    # app.bilibili.com 继续用于 JSON 去广告及 gRPC 备用通道处理。
    - "app.bilibili.com"
    - "api.live.bilibili.com"
    - "line3-h5-mobile-api.biligame.com"

  header-rewrite:
    - >-
      ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(interface\.v1\.(Teenagers\/ModeStatus|Search\/DefaultWords)|view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$ response-add 'grpc-status' '0'

  url-rewrite:
    - >-
      ^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\? - reject-dict
    - >-
      ^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? - reject-dict

  body-rewrite:
    - >-
      ^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\? response-jq .data[][]?="stun.chat.bilibili.com:3478"
    - >-
      ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(show|event\/list2)\? response-jq .data |= with_entries(if .key | IN("show", "event_list") then .value = [] else . end)
    - >-
      ^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\? response-jq .data.tab = [     {         pos: 1,         id: 477,         name: "推荐",         tab_id: "推荐tab",         uri: "bilibili://pegasus/promo",         default_selected: 1     },     {         pos: 2,         id: 478,         name: "热门",         tab_id: "热门tab",         uri: "bilibili://pegasus/hottopic"     },     {         pos: 3,         id: 545,         name: "动画",         tab_id: "bangumi",         uri: "bilibili://pgc/home"     },     {         pos: 4,         id: 151,         name: "影视",         tab_id: "film",         uri: "bilibili://pgc/cinema-tab"     },     {         pos: 5,         id: 731,         name: "直播",         tab_id: "直播tab",         uri: "bilibili://live/home"     } ] |  .data.top = [     {         pos: 1,         id: 176,         name: "消息",         tab_id: "消息Top",         uri: "bilibili://link/im_home",         icon: "http://i0.hdslb.com/bfs/archive/d43047538e72c9ed8fd8e4e34415fbe3a4f632cb.png"     } ] |  .data.bottom = [     {         pos: 1,         id: 177,         name: "首页",         tab_id: "home",         uri: "bilibili://main/home/",         icon: "http://i0.hdslb.com/bfs/archive/63d7ee88d471786c1af45af86e8cb7f607edf91b.png",         icon_selected: "http://i0.hdslb.com/bfs/archive/e5106aa688dc729e7f0eafcbb80317feb54a43bd.png"     },     {         pos: 2,         id: 179,         name: "动态",         tab_id: "dynamic",         uri: "bilibili://following/home/",         icon: "http://i0.hdslb.com/bfs/archive/86dfbe5fa32f11a8588b9ae0fccb77d3c27cedf6.png",         icon_selected: "http://i0.hdslb.com/bfs/archive/25b658e1f6b6da57eecba328556101dbdcb4b53f.png"     },     {         pos: 5,         id: 181,         name: "我的",         tab_id: "我的Bottom",         uri: "bilibili://user_center/",         icon: "http://i0.hdslb.com/bfs/archive/4b0b2c49ffeb4f0c2e6a4cceebeef0aab1c53fe1.png",         icon_selected: "http://i0.hdslb.com/bfs/archive/a54a8009116cb896e64ef14dcf50e5cade401e00.png"     } ]
    - >-
      ^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\? response-jq if .data.items then .data.items |= map(select((.banner_item == null) and (.ad_info == null) and (.card_goto == "av") and (.card_type | IN("small_cover_v2", "large_cover_single_v9", "large_cover_v1")))) end
    - >-
      ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? response-jq del(.data.payment)
    - >-
      ^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\? response-jq .data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)
    - >-
      ^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story\? response-jq if .data.items then .data.items |= map(select((.ad_info == null) and (.card_goto | IN("vertical_ad_av", "vertical_ad_live", "vertical_ad_picture") | not)) | del(.story_cart_icon, .free_flow_toast, .image_infos, .course_info, .game_info)) end
    - >-
      ^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\? response-jq .data.domains=["wss://tracker.chat.bilibili.com"]
    - >-
      ^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\? response-jq delpaths([["data","common_equip"]])
    - >-
      ^https:\/\/app\.bilibili\.com\/x\/v2\/account\/myinfo\? response-jq .data.vip |= if . != null and .status == 0 then . + { status: 1, type: 2, due_date: 9005270400000, role: 15 } else . end

  script:
    - match: ^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\?
      name: "echoResponse_27"
      type: request
      timeout: 60
      argument: |-
        text=%7B%22code%22%3A0%2C%22message%22%3A%22OK%22%2C%22ttl%22%3A1%2C%22data%22%3A%7B%22max_time%22%3A0%2C%22min_interval%22%3A31536000%2C%22pull_interval%22%3A31536000%2C%22keep_ids%22%3A%5B%5D%2C%22show%22%3A%5B%5D%2C%22list%22%3A%5B%7B%7D%5D%2C%22splash_request_id%22%3A%22%22%7D%7D&status-code=200

    - match: ^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\?
      name: "echoResponse_27"
      type: request
      timeout: 60
      argument: |-
        text=%7B%22code%22%3A0%2C%22data%22%3A%7B%22closeType%22%3A%22close_win%22%2C%22container%22%3A%5B%5D%2C%22showTime%22%3A%22%22%7D%2C%22message%22%3A%22success%22%7D&status-code=200

    - match: ^https:\/\/ap[ip]\.bilibili\.com\/x\/(?:resource\/(?:top\/activity|patch\/tab(?:\/v2)?)|v2\/search\/square|vip\/ads\/materials)\?
      name: "echoResponse_27"
      type: request
      timeout: 60
      argument: |-
        text=%7B%22code%22%3A-404%2C%22message%22%3A%22-404%22%2C%22ttl%22%3A1%2C%22data%22%3Anull%7D&status-code=200

    - match: ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$
      name: "echoResponse_27"
      type: request
      timeout: 60
      argument: |-
        base64=AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA

    - match: ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$
      name: "echoResponse_27"
      type: request
      timeout: 60
      argument: |-
        base64=AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp%2BaIlnVw5Li7KAE%3D

    - match: ^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(PlayPause|ViewEndPage))$
      name: "echoResponse_27"
      type: request
      timeout: 60
      argument: |-
        base64=AAAAAAA%3D

    - match: ^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$
      name: "空降助手_46"
      type: request
      require-body: true
      binary-mode: true
      timeout: 10
      argument: |-
        [ "off"]

    - match: ^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$
      name: "空降助手_46"
      type: request
      require-body: true
      binary-mode: true
      timeout: 10
      argument: |-
        [ true,  "off"]

    - match: ^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.(?:show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(?:unite)?\.v1\.View\/(?:View|ViewProgress|RelatesFeed)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|community\.service\.dm\.v1\.DM\/DmView|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$
      name: "ProtoBuf处理_48"
      type: response
      require-body: true
      binary-mode: true
      argument: |-
        [ "show",  true,  false,  "off"]

    - match: ^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?
      name: "移除直播间广告_49"
      type: response
      require-body: true

script-providers:
  "echoResponse_27":
    url: https://raw.githubusercontent.com/Script-Hub-Org/Script-Hub/main/scripts/echo-response.js
    interval: 86400
  "空降助手_46":
    url: https://kelee.one/Resource/JavaScript/Bilibili/Bilibili_proto_request_kokoryh.js
    interval: 86400
  "ProtoBuf处理_48":
    url: https://kelee.one/Resource/JavaScript/Bilibili/Bilibili_proto_response_kokoryh.js
    interval: 86400
  "移除直播间广告_49":
    url: https://kelee.one/Resource/JavaScript/Bilibili/Bilibili_json_kokoryh.js
    interval: 86400
