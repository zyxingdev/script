#!name=京东APP去广告
#!desc=移除京东APP开屏广告、首页推荐广告、金融广告等
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/JD.png
#!homepage=https://github.com
#!author=zyxing
#!version=1.0.1
#!date=2026-08-26

hostname = api.m.jd.com, ms.jr.jd.com, bdsp-x.jd.com, dsp-x.jd.com

# 京东开屏广告
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=start$ url reject-200

# 京东首页广告
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=queryMaterialAdverts$ url reject-200

# 京东楼层广告
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=deliverLayer$ url reject-200

# 京东广告平台
^https?:\/\/(bdsp-x|dsp-x)\.jd\.com\/adx\/ url reject-200

# 京东金融启屏广告
^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/aladdin\/(new)?na\/m\/getLoadingPicture url reject-200

# 京东分期广告
^https?:\/\/ms\.jr\.jd\.com\/gw\/generic\/base\/na\/m\/adInfo url reject-200
